38536>>>        Get HasRecord of hoDD to bHasRecord
38537>>>
38537>>>        // let's hide all buttons and then Show the ones we want
38537>>>        WebSet pbRender of oEditBtn to False
38538>>>        WebSet pbRender of oSaveBtn to False
38539>>>        WebSet pbRender of oCancelChangesBtn to False
38540>>>        WebSet pbRender of oDeleteBtn to False
38541>>>
38541>>>        If (NavigateData.bReadOnly) Begin
38543>>>            WebSet pbRender of oEditBtn to True
38544>>>        End
38544>>>>
38544>>>        Else Begin
38545>>>            WebSet pbRender of oSaveBtn to True
38546>>>            WebSet pbRender of oCancelChangesBtn to True
38547>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38548>>>        End
38548>>>>
38548>>>    End_Procedure
