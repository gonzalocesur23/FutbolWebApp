38532>>>        Case Begin
38532>>>            Case (NavigateData.eNavigateType = nfFromMain)
38534>>>                // If from main, this is a propbably a main file Select to Zoom.
38534>>>                Case Break
38535>>>
38535>>>            Case (NavigateData.eNavigateType = nfFromParent)
38538>>>                // If from parent, this is a constrained drill down.
38538>>>                Case Break
38539>>>
38539>>>            Case (NavigateData.eNavigateType = nfFromChild)
38542>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38542>>>                Case Break
38543>>>
38543>>>            Case Else // must be nfUndefined
38543>>>
38543>>>        Case End
38543>>>
38543>>>        Send SetActionButtons
38544>>>
38544>>>    End_Procedure
38545>>>
38545>>>End_Object 
