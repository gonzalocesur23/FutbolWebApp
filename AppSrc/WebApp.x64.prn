37638>>>    Procedure SetActionButtons
37641>>>        tWebNavigateData NavigateData
37641>>>        tWebNavigateData NavigateData
37641>>>        Boolean bHasRecord
37641>>>        Handle hoDD
37641>>>
37641>>>        Get Server to hoDD
37642>>>        Get GetNavigateData to NavigateData
37643>>>        Get HasRecord of hoDD to bHasRecord
37644>>>
37644>>>        // let's hide all buttons and then Show the ones we want
37644>>>        WebSet pbRender of oEditBtn to False
37645>>>        WebSet pbRender of oSaveBtn to False
37646>>>        WebSet pbRender of oCancelChangesBtn to False
37647>>>        WebSet pbRender of oDeleteBtn to False
37648>>>
37648>>>        If (NavigateData.bReadOnly) Begin
37650>>>            WebSet pbRender of oEditBtn to True
37651>>>        End
37651>>>>
37651>>>        Else Begin
