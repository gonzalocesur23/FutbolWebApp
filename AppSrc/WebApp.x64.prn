38535>>>        Get HasRecord of hoDD to bHasRecord
38536>>>
38536>>>        // let's hide all buttons and then Show the ones we want
38536>>>        WebSet pbRender of oEditBtn to False
38537>>>        WebSet pbRender of oSaveBtn to False
38538>>>        WebSet pbRender of oCancelChangesBtn to False
38539>>>        WebSet pbRender of oDeleteBtn to False
38540>>>
38540>>>        If (NavigateData.bReadOnly) Begin
38542>>>            WebSet pbRender of oEditBtn to True
38543>>>        End
38543>>>>
38543>>>        Else Begin
38544>>>            WebSet pbRender of oSaveBtn to True
38545>>>            WebSet pbRender of oCancelChangesBtn to True
38546>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38547>>>        End
38547>>>>
38547>>>    End_Procedure
