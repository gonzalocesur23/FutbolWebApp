38843>>>    Procedure SetActionButtons
38846>>>        tWebNavigateData NavigateData
38846>>>        tWebNavigateData NavigateData
38846>>>        Boolean bHasRecord
38846>>>        Handle hoDD
38846>>>
38846>>>        Get Server to hoDD
38847>>>        Get GetNavigateData to NavigateData
38848>>>        Get HasRecord of hoDD to bHasRecord
38849>>>
38849>>>        // let's hide all buttons and then Show the ones we want
38849>>>        WebSet pbRender of oEditBtn to False
38850>>>        WebSet pbRender of oSaveBtn to False
38851>>>        WebSet pbRender of oCancelChangesBtn to False
38852>>>        WebSet pbRender of oDeleteBtn to False
38853>>>
38853>>>        If (NavigateData.bReadOnly) Begin
38855>>>            WebSet pbRender of oEditBtn to True
38856>>>        End
38856>>>>
38856>>>        Else Begin
38857>>>            WebSet pbRender of oSaveBtn to True
38858>>>            WebSet pbRender of oCancelChangesBtn to True
38859>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38860>>>        End
38860>>>>
38860>>>    End_Procedure
