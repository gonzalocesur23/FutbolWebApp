38884>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38884>>>                Case Break
38885>>>
38885>>>            Case Else // must be nfUndefined
38885>>>
38885>>>        Case End
38885>>>
38885>>>        Send SetActionButtons
