38501>>>    Procedure SetActionButtons
38504>>>        tWebNavigateData NavigateData
38504>>>        tWebNavigateData NavigateData
38504>>>        Boolean bHasRecord
38504>>>        Handle hoDD
38504>>>
38504>>>        Get Server to hoDD
38505>>>        Get GetNavigateData to NavigateData
38506>>>        Get HasRecord of hoDD to bHasRecord
38507>>>
38507>>>        // let's hide all buttons and then Show the ones we want
38507>>>        WebSet pbRender of oEditBtn to False
38508>>>        WebSet pbRender of oSaveBtn to False
38509>>>        WebSet pbRender of oCancelChangesBtn to False
38510>>>        WebSet pbRender of oDeleteBtn to False
38511>>>
38511>>>        If (NavigateData.bReadOnly) Begin
38513>>>            WebSet pbRender of oEditBtn to True
38514>>>        End
38514>>>>
38514>>>        Else Begin
38515>>>            WebSet pbRender of oSaveBtn to True
38516>>>            WebSet pbRender of oCancelChangesBtn to True
38517>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38518>>>        End
38518>>>>
38518>>>    End_Procedure
38519>>>
